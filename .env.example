# Docker Compose settings (copy to .env)
# Commented-out values show the defaults from backend/internal/config/config.go.
# These can also be changed on the Settings page; a value saved there overrides this
# file until it is reset: MAIL_PROVIDER, INBOX_SYNC_INTERVAL, MAILTM_REQUEST_DELAY,
# INBOX_SEARCH_MAX_PAGES, MESSAGE_RETENTION, USERNAME_MAX_ATTEMPTS, USERNAME_FIRST_NAMES,
# USERNAME_LAST_NAMES, LEGACY_USERNAME_PATTERN, TAG_MAX_LENGTH, NOTE_MAX_LENGTH,
# BULK_GENERATE_MAX, AUTO_MARK_USED, ACCOUNT_CLEANUP_AFTER, ACCOUNT_CLEANUP_ACTION.

# Port the app is served on: http://localhost:3000
WEB_PORT=3000
# Interface the app listens on. 127.0.0.1 = this computer only (recommended: the app has no
# login and shows OTPs). 0.0.0.0 exposes it to everyone on your network.
# WEB_BIND=127.0.0.1

# Postgres inside Docker (not exposed outside the Docker network)
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=qa_mail_manager

TZ=Asia/Jakarta

# ---- Inbox --------------------------------------------------------------------
# How often every account's newest-message time is refreshed (0 disables)
INBOX_SYNC_INTERVAL=2m
# Pause between Mail.tm accounts during the background sync (Mail.tm allows ~8 req/s)
# MAILTM_REQUEST_DELAY=400ms
# Max inbox pages (30 messages each) scanned by a search
# INBOX_SEARCH_MAX_PAGES=10
# Heartbeat that keeps the live-update stream (GET /api/events) open through proxies
# EVENTS_HEARTBEAT_INTERVAL=20s

# ---- Mail providers -----------------------------------------------------------
# Default provider for new accounts: mailtm (public Mail.tm) or local (our catch-all domain)
MAIL_PROVIDER=mailtm
# Our own catch-all domain(s) for the local provider, comma-separated; new addresses are
# spread over them (each needs its own Email Routing catch-all -> Worker). Empty disables it.
CATCHALL_DOMAIN=

# ---- Ingest (Cloudflare Email Worker -> tunnel -> backend) ---------------------
# Shared with the Worker (wrangler secret put INGEST_SECRET); at least 32 characters.
# Empty disables the ingest server. Generate one with: openssl rand -hex 32
INGEST_SECRET=
# Port of the ingest-only server inside the backend container
# INGEST_PORT=8081
# Max raw email size in bytes (Cloudflare Email Routing itself caps messages at 25 MiB)
# INGEST_MAX_BYTES=26214400

# Delete stored local-provider messages older than this (0 keeps them forever)
# MESSAGE_RETENTION=720h
# MESSAGE_PRUNE_INTERVAL=1h

# Cloudflare tunnel: uncomment both to start the cloudflared container
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=
# Pinned so a rebuild never pulls an untested release; bump deliberately
# CLOUDFLARED_VERSION=2026.9.3

# ---- Generated accounts --------------------------------------------------------
# Retries when a generated address is already taken
# USERNAME_MAX_ATTEMPTS=5
# Comma-separated name pools; empty uses the built-in Indonesian names
# USERNAME_FIRST_NAMES=budi,sari,dewi
# USERNAME_LAST_NAMES=santoso,wijaya,lubis
# Label length limits (characters); the UI reads them from GET /api/settings
# TAG_MAX_LENGTH=50
# NOTE_MAX_LENGTH=500
# Accounts whose address (part before @) matches this regexp get an "Old format" badge and
# a Replace action; empty disables the check
# LEGACY_USERNAME_PATTERN=^qa_test_
# Most accounts one bulk generate ("How many") may create
# BULK_GENERATE_MAX=50

# ---- Account lifecycle -------------------------------------------------------------
# Mark Available accounts as Used automatically: off, first_message, otp_copied
# AUTO_MARK_USED=off
# Clean up accounts without mail for this long (0 disables), by blocking or deleting them
# ACCOUNT_CLEANUP_AFTER=0
# ACCOUNT_CLEANUP_ACTION=block

# ---- Sending (reply from own-domain accounts) -------------------------------------
# SMTP server that may send as your catch-all domain (e.g. Resend, Brevo, Mailgun with the
# domain verified). Empty SMTP_HOST disables sending. SMTP_SECURITY: starttls, tls or none.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SECURITY=starttls
