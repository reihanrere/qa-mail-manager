APP_NAME=QA Mail Manager
APP_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=qa_mail_manager

MAILTM_BASE_URL=https://api.mail.tm
INBOX_SYNC_INTERVAL=2m
# MAILTM_REQUEST_DELAY=400ms
# INBOX_SEARCH_MAX_PAGES=10

# mailtm or local; CATCHALL_DOMAIN enables generating on the local provider
MAIL_PROVIDER=mailtm
CATCHALL_DOMAIN=

# Empty disables the ingest server; at least 32 characters (openssl rand -hex 32)
INGEST_SECRET=
# INGEST_PORT=8081
# INGEST_MAX_BYTES=26214400
# MESSAGE_RETENTION=720h
# MESSAGE_PRUNE_INTERVAL=1h

# USERNAME_MAX_ATTEMPTS=5
# USERNAME_FIRST_NAMES=
# USERNAME_LAST_NAMES=
# TAG_MAX_LENGTH=50
# NOTE_MAX_LENGTH=500
# LEGACY_USERNAME_PATTERN=^qa_test_
# EVENTS_HEARTBEAT_INTERVAL=20s
# BULK_GENERATE_MAX=50
# AUTO_MARK_USED=off
# ACCOUNT_CLEANUP_AFTER=0
# ACCOUNT_CLEANUP_ACTION=block
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SECURITY=starttls
